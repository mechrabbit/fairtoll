{
	"name": "fairtoll",
	"version": "0.0.0",
	"private": true,
	"license": "UNLICENSED",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/core/index.d.ts",
			"default": "./dist/core/index.js"
		},
		"./express": {
			"types": "./dist/express/index.d.ts",
			"default": "./dist/express/index.js"
		},
		"./next": {
			"types": "./dist/next/index.d.ts",
			"default": "./dist/next/index.js"
		}
	},
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=20"
	},
	"peerDependencies": {
		"express": "^5.0.0",
		"next": "^16.0.0"
	},
	"peerDependenciesMeta": {
		"express": {
			"optional": true
		},
		"next": {
			"optional": true
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc --noEmit && tsc --noEmit -p src/core",
		"lint": "eslint .",
		"test": "vitest run",
		"demo:serve": "npm run build --silent && node demo/serve.js",
		"demo:next": "npm run build --silent && next build demo/next && next start demo/next",
		"bench": "npm run build --silent && node bench/latency.js"
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "1.4.6",
		"@types/express": "5.0.6",
		"@types/node": "24.19.2",
		"@types/parseurl": "1.3.3",
		"eslint": "10.13.0",
		"express": "5.2.1",
		"next": "16.4.1",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.0",
		"vitest": "5.0.5"
	},
	"dependencies": {
		"@x402/core": "2.28.0",
		"@x402/evm": "2.28.0",
		"parseurl": "^1.3.3",
		"viem": "2.57.13"
	}
}
