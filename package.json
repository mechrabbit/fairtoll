{
	"name": "fairtoll",
	"version": "0.1.0",
	"description": "See, block and charge for AI bot and agent traffic on your own site, with x402 payments.",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mechrabbit/fairtoll.git"
	},
	"homepage": "https://github.com/mechrabbit/fairtoll#readme",
	"bugs": {
		"url": "https://github.com/mechrabbit/fairtoll/issues"
	},
	"keywords": [
		"ai",
		"bots",
		"crawlers",
		"x402",
		"paywall",
		"express",
		"middleware"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/core/index.d.ts",
			"default": "./dist/core/index.js"
		},
		"./express": {
			"types": "./dist/express/index.d.ts",
			"default": "./dist/express/index.js"
		}
	},
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=20"
	},
	"peerDependencies": {
		"express": "^5.0.0"
	},
	"peerDependenciesMeta": {
		"express": {
			"optional": true
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"prepack": "npm run build",
		"typecheck": "tsc --noEmit && tsc --noEmit -p src/core",
		"lint": "eslint .",
		"test": "vitest run",
		"demo:serve": "npm run build --silent && node demo/serve.js",
		"bench": "npm run build --silent && node bench/latency.js"
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "1.4.6",
		"@types/express": "5.0.6",
		"@types/node": "24.19.2",
		"@types/parseurl": "1.3.3",
		"eslint": "10.13.0",
		"express": "5.2.1",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.0",
		"vitest": "5.0.5"
	},
	"dependencies": {
		"@x402/core": "2.28.0",
		"@x402/evm": "2.28.0",
		"parseurl": "^1.3.3",
		"viem": "2.57.13"
	}
}
